# Variables the server reads. Their values live in Infisical; run commands
# through `infisical run -- <command>` instead of copying this to .env.
# Every value is optional; defaults are in app/config.py.

FASTF1_CACHE_DIR=cache
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Number of uvicorn worker processes the Docker image starts (default 2).
WEB_CONCURRENCY=2

CACHE_HIGH_WATER=0.85
CACHE_LOW_WATER=0.70
CACHE_PRUNE_INTERVAL_SECONDS=600

# F1 account FastF1 signs in with, since live timing needs an F1 TV Access
# subscription. Without it no session can be loaded from live timing.
F1_USERNAME=
F1_PASSWORD=

UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_READ_TIMEOUT_SECONDS=30

# Session archive. R2 is used when R2_BUCKET and its credentials are set,
# otherwise the local folder in ARCHIVE_LOCAL_DIR, otherwise it's disabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
ARCHIVE_LOCAL_DIR=archive_data
